{
  "name": "mdd",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "esbuild src/sftp.test.mjs --bundle --platform=node --format=esm --packages=external --outfile=.sftptest.mjs --log-level=error && node --import 'data:text/javascript,globalThis.self=globalThis' .sftptest.mjs; code=$?; rm -f .sftptest.mjs; exit $code",
    "dev:worker": "wrangler dev --port 8787",
    "test:relay": "node worker/relay.test.mjs",
    "test:layout": "node src/layout.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.3",
    "@microsoft/dev-tunnels-ssh": "^3.12.40",
    "@microsoft/dev-tunnels-ssh-keys": "^3.12.40",
    "codemirror": "^6.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  }
}
